{
  "source": ["src/tokens/*.json"],
  "platforms": {
    "css": {
      "transformGroup": "css",
      "buildPath": "build/",
      "transforms": [
        "attribute/cti",
        "name/cti/snake",
        "color/hex",
        "size/rem",
        "custom/typo",
        "custom/shadow"
      ],
      "files": [
        {
          "destination": "tokens.css",
          "format": "customCssFormat",
          "options": {
            "showFileHeader": false,
            "outputReferences": true
          }
        },
        {
          "destination": "tokens.scss",
          "format": "customScssFormat",
          "options": {
            "outputReferences": true
          }
        }
      ]
    }
  }
}
